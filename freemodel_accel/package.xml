<?xml version="1.0"?>
<package format="3">
  <name>freemodel_accel</name>
  <version>0.0.1</version>
  <description>Trajectory-based follower variant for SO100/SO101 using position, velocity, and acceleration commands.</description>

  <maintainer email="basanta@example.com">basanta</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
